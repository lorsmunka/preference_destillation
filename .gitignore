# Data files (generated on server, scp'd down)
batches/
logs12b/
inferences/
evals/

# Input data — each domain's corpus.py writes corpus.jsonl next to the domain
library/domain/*/corpus.jsonl
sentences/sentences.jsonl

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.matplotlib-cache/

# Model files
checkpoints/
*.pt
runs/**/checkpoints/

# Misc
test.json

# OS
.DS_Store
Thumbs.db

node_modules/
# Archived run artifacts (see saves/runs-archive-manifest.tsv)
saves/
experiments/*.log
convert_batches.log
progress_server.log
gemma4*_download.log
sanity_*.log
STOP
queue/

# Run artifacts stay on disk (and in saves/); git keeps the results CSVs and the code that made them
runs/
models/
reshard.log
diag_*.log
generate_*.log

# Downloaded public datasets (re-fetchable; the filtered sets live under library/domain/*/benchmarks/)
datasets/

# math_tutor: large derived files, rebuilt byte-identically by prune / renumber (~10 min)
library/domain/math_tutor/items/items.jsonl
library/domain/math_tutor/items/renumbered.jsonl
library/domain/*/corpus_*.jsonl
# the full run's conversations: 103 MB after the second loop, over GitHub's 100 MB per file (user, 2026-10-27: "fine")
library/domain/math_tutor/items/conversations/full_v1.jsonl

# code_agent: derived files, rebuilt by python -m library.domain.code_agent.requests / .vocabulary
library/domain/code_agent/items.jsonl

# the user's own thesis files stay local: the pre-submission checklist and the NIK-format preview
# (rebuilt by agents/work/thesis_preview_2026-11-04/build_preview.js + word_finish.ps1)
thesis_work/new_thesis/notes_before_submitting.md
thesis_work/new_thesis/thesis_preview.docx
thesis_work/new_thesis/thesis_preview.pdf

# game-language agent: derived problem files (rebuilt by problems.py)
library/domain/game_dsl/problems/*
!library/domain/game_dsl/problems/commands.jsonl
