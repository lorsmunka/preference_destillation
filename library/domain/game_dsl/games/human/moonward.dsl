Window {
    size(8, 12)
    worldSize(8, 128)
    cameraFollow("hero")
    background("0a0d24")
    music("bg_ambient")
    gravity(1500)

    Bar("m") { initial(0) }
    Bar("stars") { initial(0) }

    Entity { id("k0") startPosition(0, 0) color("1f301d") Type { rectangle(800, 2000) } }
    Entity { id("k1") startPosition(0, 1992) color("e66e52") Type { rectangle(800, 158) } }
