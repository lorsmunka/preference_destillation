    Entity { id("k45") startPosition(0, 8592) color("41387c") Type { rectangle(800, 158) } }
    Entity { id("k46") startPosition(0, 8742) color("3e377a") Type { rectangle(800, 158) } }
    Entity { id("k47") startPosition(0, 8892) color("3c3677") Type { rectangle(800, 158) } }
    Entity { id("k48") startPosition(0, 9042) color("393474") Type { rectangle(800, 158) } }
    Entity { id("k49") startPosition(0, 9192) color("363372") Type { rectangle(800, 158) } }
    Entity { id("k50") startPosition(0, 9342) color("34326f") Type { rectangle(800, 158) } }
    Entity { id("k51") startPosition(0, 9492) color("31306c") Type { rectangle(800, 158) } }
    Entity { id("k52") startPosition(0, 9642) color("2f2f6a") Type { rectangle(800, 158) } }
    Entity { id("k53") startPosition(0, 9792) color("2c2e67") Type { rectangle(800, 158) } }
    Entity { id("k54") startPosition(0, 9942) color("2a2c64") Type { rectangle(800, 158) } }
    Entity { id("k55") startPosition(0, 10092) color("272b61") Type { rectangle(800, 158) } }
    Entity { id("k56") startPosition(0, 10242) color("242a5f") Type { rectangle(800, 158) } }
    Entity { id("k57") startPosition(0, 10392) color("22285c") Type { rectangle(800, 158) } }
    Entity { id("k58") startPosition(0, 10542) color("1f2759") Type { rectangle(800, 158) } }
    Entity { id("k59") startPosition(0, 10692) color("1e2556") Type { rectangle(800, 158) } }
    Entity { id("k60") startPosition(0, 10842) color("1c2452") Type { rectangle(800, 158) } }
    Entity { id("k61") startPosition(0, 10992) color("1b224e") Type { rectangle(800, 158) } }
    Entity { id("k62") startPosition(0, 11142) color("19204b") Type { rectangle(800, 158) } }
    Entity { id("k63") startPosition(0, 11292) color("181e47") Type { rectangle(800, 158) } }
    Entity { id("k64") startPosition(0, 11442) color("161c43") Type { rectangle(800, 158) } }
    Entity { id("k65") startPosition(0, 11592) color("151b40") Type { rectangle(800, 158) } }
    Entity { id("k66") startPosition(0, 11742) color("13193c") Type { rectangle(800, 158) } }
    Entity { id("k67") startPosition(0, 11892) color("121738") Type { rectangle(800, 158) } }
    Entity { id("k68") startPosition(0, 12042) color("111535") Type { rectangle(800, 158) } }
    Entity { id("k69") startPosition(0, 12192) color("0f1331") Type { rectangle(800, 158) } }
    Entity { id("k70") startPosition(0, 12342) color("0e122d") Type { rectangle(800, 158) } }
    Entity { id("k71") startPosition(0, 12492) color("0c102a") Type { rectangle(800, 158) } }
    Entity { id("k72") startPosition(0, 12642) color("0b0e26") Type { rectangle(800, 158) } }
    Entity { id("gr") startPosition(0, 1960) color("2f4a2c") Type { rectangle(800, 80) } }

    Entity { id("gl") template(true) color("18fef3c7") Type { circle(170) } }
    Entity { id("mn") template(true) color("fef3c7") Type { circle(110) } }
    Entity { id("fn") template(true) color("0000") Type { rectangle(800, 20) } }
    Entity { id("pl") template(true) color("e0f2fe") Type { rectangle(120, 12) } }
    Entity { id("sp") template(true) color("fde047") Type { rectangle(120, 12) } }
    Entity { id("cr") template(true) color("8094a3b8") Type { rectangle(120, 12) } }
    Entity { id("mv") template(true) color("a5f3fc") Type { rectangle(120, 12) } gravity(0)
        Movement { speed(1.2) AutoMove { direction(1, 0) } }
        Events { OnCollision { Actions { bounceBack() } } } }
    Entity { id("st") template(true) color("fde047") Type { star(5, 16, 7) } }
    Entity { id("dt") template(true) color("b3ffffff") Type { circle(2) } }
    Entity { id("mk") template(true) color("0000") Type { rectangle(1600, 8) }
        Events { OnCollision("hero") { Actions { updateBar("m", 7) deleteEntity() } } } }

    Entity { id("bd") startPosition(400, 2040) color("0000") Type { rectangle(0, 0) }
        Movement { GridMove(1) }
        var("z", 0)
        Events { OnElapsedTime { Actions {
            loopCount(25) whenVar("z", "==", 0) { Actions {
                gridStep(random(-200, 200), random(110, 150))
                randomAction {
                    Actions { spawnHere("pl") } Actions { spawnHere("pl") } Actions { spawnHere("pl") }
                    Actions { spawnHere("pl") spawnHere("st") } Actions { spawnHere("sp") } }
                spawnHere("mk") } }
            loopCount(25) whenVar("z", "==", 0) { Actions {
                gridStep(random(-220, 220), random(120, 165))
                randomAction {
                    Actions { spawnHere("pl") } Actions { spawnHere("pl") } Actions { spawnHere("mv") }
                    Actions { spawnHere("cr") } Actions { spawnHere("pl") spawnHere("st") } Actions { spawnHere("sp") } }
                spawnHere("mk") } }
            loopCount(25) whenVar("z", "==", 0) { Actions {
                gridStep(random(-240, 240), random(135, 180))
                randomAction {
                    Actions { spawnHere("pl") } Actions { spawnHere("mv") } Actions { spawnHere("mv") }
                    Actions { spawnHere("cr") } Actions { spawnHere("cr") } Actions { spawnHere("mv") spawnHere("st") }
                    Actions { spawnHere("sp") } }
                spawnHere("mk") } }
            loopCount(35) whenVar("z", "==", 0) { Actions {
                gridStep(random(-240, 240), random(135, 180))
                randomAction {
                    Actions { spawnHere("pl") } Actions { spawnHere("mv") } Actions { spawnHere("mv") }
                    Actions { spawnHere("cr") } Actions { spawnHere("cr") } Actions { spawnHere("mv") spawnHere("st") }
                    Actions { spawnHere("sp") } }
                spawnHere("mk") } } } } } }
    Entity { id("sk") startPosition(400, 3400) color("0000") Type { rectangle(0, 0) }
        Movement { GridMove(1) }
        var("z", 0)
        Events { OnElapsedTime { Actions { loopCount(100) whenVar("z", "==", 0) { Actions {
            gridStep(random(-360, 360), random(70, 120)) spawnHere("dt") } } } } } }
    Entity { id("vd") template(true) color("05060f") Type { rectangle(800, 1600) } gravity(0)
        Movement { speed(0.05) AutoMove { direction(0, 1) } }
        Events { Sequence {
            Phase(1, 4) { Actions { updateSpeed(1.6) } }
            Phase(1, 8) { Actions { updateSpeed(2) } }
            Phase(1, 8) { Actions { updateSpeed(2.3) } }
            Phase(1, 8) { Actions { updateSpeed(2.6) } }
            Phase(1, 8) { Actions { updateSpeed(2.9) } } } } }
    Entity { id("ve") template(true) color("6c8bff") Type { rectangle(800, 6) } gravity(0)
        Movement { speed(0.05) AutoMove { direction(0, 1) } }
        Events { Sequence {
            Phase(1, 4) { Actions { updateSpeed(1.6) } }
            Phase(1, 8) { Actions { updateSpeed(2) } }
            Phase(1, 8) { Actions { updateSpeed(2.3) } }
            Phase(1, 8) { Actions { updateSpeed(2.6) } }
            Phase(1, 8) { Actions { updateSpeed(2.9) } } }
            OnElapsedTime(0.12) { repeatCount(-1) Actions { burst(3, "6c8bff") } } } }

    Entity { id("hero") template(true) color("fff7d6") Type { circle(15) }
        Movement { speed(9) Control { movementControl(2) } }
        var("up", 0)
        Events {
            OnElapsedTime(0.05) { repeatCount(-1) Actions { burst(1, "fde68a") } }
            OnCollision("pl") { Actions { whenVar("up", "==", 0) { Actions {
                setVelocity(0, 980) changeVar("up", 1) delay(0.65) { Actions { changeVar("up", -1) } }
                sound("jump") burst(6, "e0f2fe") } } } }
            OnCollision("mv") { Actions { whenVar("up", "==", 0) { Actions {
                setVelocity(0, 980) changeVar("up", 1) delay(0.65) { Actions { changeVar("up", -1) } }
                sound("jump") burst(6, "a5f3fc") } } } }
            OnCollision("cr") { Actions { whenVar("up", "==", 0) { Actions {
                setVelocity(0, 980) changeVar("up", 1) delay(0.65) { Actions { changeVar("up", -1) } }
                sound("glass") burst(14, "94a3b8") deleteCollider() } } } }
            OnCollision("sp") { Actions { whenVar("up", "==", 0) { Actions {
                setVelocity(0, 1550) changeVar("up", 1) delay(1.03) { Actions { changeVar("up", -1) } }
                sound("sparkle") burst(20, "fde047") } } } }
            OnCollision("gr") { Actions { whenVar("up", "==", 0) { Actions {
                setVelocity(0, 980) changeVar("up", 1) delay(0.65) { Actions { changeVar("up", -1) } } } } } }
            OnCollision("st") { Actions { updateBar("stars", 1) sound("coin") burst(12, "fde047") deleteCollider() } }
            OnCollision("vd") { Actions { sound("death") shake(8, 0.5) gameOver("-- THE NIGHT CAUGHT YOU --") } }
            OnCollision("fn") { Actions { sound("win") burst(60, "fef3c7") gameOver("-- YOU REACHED THE MOON --") } }
        } }

    Entity { id("ti") template(true) color("fff7d6") Type { text("MOONWARD
", 64) }
        Events { OnElapsedTime(3) { Actions { deleteEntity() } } } }
    Entity { id("su") template(true) color("fde68a") Type { text("
climb before the night catches you", 26) }
        Events { OnElapsedTime(3) { Actions { deleteEntity() } } } }
    Entity { id("hi") template(true) color("fff7d6") Type { text("


hold the spark and slide", 26) }
        Events { OnElapsedTime(4) { Actions { deleteEntity() } } } }

    Entity { id("dir") startPosition(400, 2400) color("0000") Type { rectangle(0, 0) }
        Events {
            OnElapsedTime { Actions { spawnHere("ti") spawnHere("su")
                spawn("gl", 230, 11940) spawn("mn", 290, 12000) spawn("fn", 0, 12100) spawn("vd", 0, 0) spawn("ve", 0, 1600) spawn("hero", 385, 2100) spawnHere("hi") } } } }
}
