    Entity { id("k26") startPosition(0, 5742) color("8f4b7a") Type { rectangle(800, 158) } }
    Entity { id("k27") startPosition(0, 5892) color("8b4a7c") Type { rectangle(800, 158) } }
    Entity { id("k28") startPosition(0, 6042) color("86497d") Type { rectangle(800, 158) } }
    Entity { id("k29") startPosition(0, 6192) color("81487f") Type { rectangle(800, 158) } }
    Entity { id("k30") startPosition(0, 6342) color("7d477f") Type { rectangle(800, 158) } }
