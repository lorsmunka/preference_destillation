    Entity { id("k37") startPosition(0, 7392) color("604180") Type { rectangle(800, 158) } }
    Entity { id("k38") startPosition(0, 7542) color("5c4080") Type { rectangle(800, 158) } }
    Entity { id("k39") startPosition(0, 7692) color("583f80") Type { rectangle(800, 158) } }
    Entity { id("k40") startPosition(0, 7842) color("533e80") Type { rectangle(800, 158) } }
    Entity { id("k41") startPosition(0, 7992) color("4f3d80") Type { rectangle(800, 158) } }
